# Copy to .env for local runs (never commit .env). In GitHub Actions these come from
# repository secrets / the workflow file instead.

# --- GitHub ---------------------------------------------------------------
# Actions provides GITHUB_TOKEN automatically. For local runs use a fine-grained PAT
# limited to this repository: Pull requests (read/write), Contents (read).
GITHUB_TOKEN=
# Only needed for the optional webhook server (webhook_server.py).
GITHUB_WEBHOOK_SECRET=
# Optional comma-separated allow-list, e.g. vishwanathrathrey/Portfolio
ALLOWED_REPOS=
PUBLISH_GITHUB_REVIEW=true
MAX_INLINE_COMMENTS=25

# --- Local Ollama (the only AI inference path) -----------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=qwen2.5-coder:7b
OLLAMA_FALLBACK_MODEL=mistral
# Reserved for embedding features; not used for review generation.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_GENERATE_TIMEOUT=600
OLLAMA_MAX_RETRIES=1
OLLAMA_RETRY_BACKOFF=2
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.1

# --- Diff limits (nothing is skipped silently; skips are reported) ----------
MAX_CHUNK_CHARS=6000
MAX_FILES=50
MAX_TOTAL_CHARS=120000

# --- E-mail via Resend ----------------------------------------------------
RESEND_API_KEY=
REVIEW_EMAIL_TO=
# Resend's shared test sender can only deliver to your own Resend account address;
# use a verified domain for anything else.
REVIEW_EMAIL_FROM=aireviewer@resend.dev

# --- Runtime ----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Defaults to ~/.ai-code-review/state.db
AI_REVIEW_STATE_DB=
# Webhook server only
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=5000
